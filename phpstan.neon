includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    phpVersion: 80200
    paths:
        - src
        - tests
    excludePaths:
        - tests/ArchSupport.php
        - tests/ArchShapeTest.php
        - tests/ArchDocsTest.php
        - tests/ArchLayeringTest.php
    treatPhpDocTypesAsCertain: false
