{
    "name": "al-falaq/al-falaq",
    "description": "Offline, zero-dependency PHP library for Islamic astronomy: prayer times, Qibla, Sunnah markers, crescent visibility, and Hijri conversion.",
    "keywords": ["islam", "prayer-times", "qibla", "hijri", "astronomy", "crescent", "umm-al-qura"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "suggest": {
        "psr/clock": "For ClockInterface injection at edges (NextPrayerResolver, examples)"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "rector/rector": "^2.0",
        "infection/infection": "^0.29"
    },
    "autoload": {
        "psr-4": {
            "AlFalaq\\AlFalaq\\": "src/"
        },
        "exclude-from-classmap": [
            "tests/",
            "examples/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AlFalaq\\AlFalaq\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "find src examples tools tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test-unit": "phpunit --no-coverage",
        "test": "php tools/coverage_gate.php --min=85",
        "arch": "phpunit --group arch",
        "bench": "php examples/bench.php --budget",
        "ci": ["@lint", "@cs", "@stan", "@test"]
    }
}
