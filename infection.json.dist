{
    "$schema": "https://github.com/infection/infection/blob/master/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": ["Astro/Services/KarneyInverse.php"]
    },
    "logs": {
        "text": "infection.log"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 85,
    "minCoveredMsi": 85,
    "timeout": 10
}
